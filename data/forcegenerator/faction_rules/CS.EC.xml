<ruleset faction="CS.EC" parent="CS" ratingSystem="SL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="formationRulesetSchema.xsd">

    <!-- The Explorer Corps is ComStar's survey arm, not a line command. It draws on the same roster
    and the same equipment ratings as the Com Guards - no tech percentages are declared here, so it
    inherits ComStar's - and it uses the same Level IV, Level III and Level I rules, which are
    inherited through the parent ruleset.

    What differs is the Level II. An explorer command is built to travel and to look, not to hold
    ground: it is markedly lighter, it leans on its scouts, and it carries far more infantry than a
    Com Guard formation of the same size, because a survey team is an infantry team. The Level II
    below is the Com Guard one with those three changes made; everything else about it, including
    the composition-to-unit-mix tables, is deliberately identical.

    Battle armor is gated to 3055 and later. The Explorer Corps has been running since 2959 and
    Inner Sphere battle armor does not exist for most of that span. -->

    <!-- Restated rather than inherited: a ruleset applies its own defaults, so without these the
    Explorer Corps would generate with no equipment rating at all while the Com Guards generate at
    A, which changes which units are drawn quite apart from any rule below. -->
    <defaults>
        <echelon>%LEVEL_IV%</echelon>
        <rankSystem>%RANK_CS%</rankSystem>
        <rating>A</rating>
    </defaults>

    <force echelon="%LEVEL_II%" eschName="Level II">
        <name>II {formation}</name>
        <co>%ADEPT%</co>

        <!-- Assault and heavy formations are rare in a survey command; light and medium
        ones carry the work. -->
        <weightClass>
            <option weight="1">A</option>
            <option weight="3">H</option>
            <option weight="10">M</option>
            <option weight="10">L</option>
        </weightClass>

        <flags ifRole="artillery">
            <option weight="25">0600</option>
            <option weight="10">0060</option>
            <option weight="3">4200</option>
            <option weight="2">4020</option>
            <option weight="2">2400</option>
            <option weight="2">2040</option>
            <option weight="6">0240</option>
        </flags>

        <flags ifRole="!artillery"
               ifFlags="!4200|0402|2400|4002|6000|2040|0240|0060|2022|0042|2202|4020|0222|0600">
