        </ruleGroup>

        <ruleGroup>
            <formation ifFlags="!0060|0042|2040|0240|2022|0222">
                <option weight="12">Fire</option>
                <option weight="6">Fire Support</option>
                <option weight="4" ifWeightClass="H|A">Direct Fire</option>
                <option weight="4" ifWeightClass="L|M">Light Fire</option>
                <option weight="2" role="+anti_aircraft">Anti-Air</option>
                <option weight="2" ifWeightClass="H|A">Assault</option>
                <option weight="20" ifWeightClass="H|A">Battle</option>
                <option weight="10" ifWeightClass="H|A">Heavy Battle</option>
                <option weight="20" ifWeightClass="M">Medium Battle</option>
                <option weight="20" ifWeightClass="L">Light Battle</option>
                <option weight="3" ifWeightClass="H|A">Assault</option>
                <option weight="4" ifWeightClass="L|M|H">Striker/Cavalry</option>
                <option weight="2" ifWeightClass="H|A">Heavy Striker/Cavalry</option>
                <option weight="2" ifWeightClass="L">Light Striker/Cavalry</option>
                <option weight="8" ifWeightClass="L|M|H">Ranger</option>
                <option weight="8" ifWeightClass="L|M|H">Pursuit</option>
                <option weight="14" ifWeightClass="L|M|H">Probe</option>
                <option weight="12" ifWeightClass="L|M|H">Sweep</option>
