            <option weight="2">0240</option>
        </flags>

        <ruleGroup>
            <flags ifFlags="4020|0420|3030|0330">
                <option augmented="1" />
            </flags>
        </ruleGroup>

        <ruleGroup>
            <formation ifRole="command">
                <option ifFlags="6000|4200|4020|4002|3300|3030|3003">Command</option>
                <option ifFlags="0600|2400|0420|0402|3300|0330|0303">Vehicle Command</option>
            </formation>

            <formation ifRole="artillery" ifFlags="!0060|2040|0240">
                <option>Artillery Fire</option>
