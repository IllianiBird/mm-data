<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified">

    <!-- Matches the predicate vocabulary implemented in megamek RulesetNode.matches(). -->
    <xs:attributeGroup name="predicateAttributeGroup">
        <xs:attribute name="ifUnitType" type="xs:string" />
        <xs:attribute name="ifWeightClass" type="xs:string" />
        <xs:attribute name="ifRating" type="xs:string" />
        <xs:attribute name="ifRole" type="xs:string" />
        <xs:attribute name="ifMotive" type="xs:string" />
        <xs:attribute name="ifAugmented" type="xs:boolean" />
        <xs:attribute name="ifDateBetween" type="xs:string" />
        <xs:attribute name="ifTopLevel" type="xs:boolean" />
        <xs:attribute name="ifName" type="xs:string" />
        <xs:attribute name="ifFaction" type="xs:string" />
        <xs:attribute name="ifFlags" type="xs:string" />
        <xs:attribute name="ifIndex" type="xs:string" />
        <xs:attribute name="ifEschelon" type="xs:string" />
    </xs:attributeGroup>

    <xs:attributeGroup name="assertionAttributeGroup">
        <xs:attribute name="unitType" type="xs:string" />
        <xs:attribute name="weightClass" type="xs:string" />
        <xs:attribute name="rating" type="xs:string" />
        <xs:attribute name="formation" type="xs:string" />
        <xs:attribute name="role" type="xs:string" />
        <xs:attribute name="motive" type="xs:string" />
        <xs:attribute name="augmented" type="xs:boolean" />
        <xs:attribute name="chassis" type="xs:string" />
        <xs:attribute name="model" type="xs:string" />
        <xs:attribute name="variant" type="xs:string" />
        <xs:attribute name="name" type="xs:string" />
        <xs:attribute name="fluffName" type="xs:string" />
        <xs:attribute name="faction" type="xs:string" />
        <xs:attribute name="flags" type="xs:string" />
    </xs:attributeGroup>

    <xs:group name="ruleGroup">
        <xs:choice>
            <xs:element name="weightClass" type="optionGroupType" />
            <xs:element name="unitType" type="optionGroupType" />
            <xs:element name="chassis" type="optionGroupType" />
            <xs:element name="variant" type="optionGroupType" />
            <xs:element name="motive" type="optionGroupType" />
            <xs:element name="formation" type="optionGroupType" />
            <xs:element name="role" type="optionGroupType" />
            <xs:element name="flags" type="optionGroupType" />
            <xs:element name="changeEschelon" type="optionGroupType" />
        </xs:choice>
    </xs:group>

    <xs:element name="ruleset">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="defaults" />
                <xs:element minOccurs="0" maxOccurs="1" ref="customRanks" />
                <xs:element minOccurs="0" maxOccurs="1" ref="toc" />
                <xs:element minOccurs="0" maxOccurs="1" ref="formationNaming" />
                <xs:element minOccurs="0" maxOccurs="unbounded" ref="force" />
            </xs:sequence>
            <xs:attribute name="faction" type="xs:string" />
            <xs:attribute name="parent" type="xs:string" />
            <xs:attribute name="ratingSystem">
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:pattern value="IS|SL|CLAN|ROS" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="defaults">
        <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element name="unitType">
                    <xs:complexType>
                        <xs:simpleContent>
                            <xs:extension base="xs:string">
                                <xs:attributeGroup
                                        ref="predicateAttributeGroup" />
                            </xs:extension>
                        </xs:simpleContent>
                    </xs:complexType>
                </xs:element>
                <xs:element name="echelon">
                    <xs:complexType>
                        <xs:simpleContent>
                            <xs:extension base="xs:string">
                                <xs:attributeGroup
                                        ref="predicateAttributeGroup" />
                            </xs:extension>
                        </xs:simpleContent>
                    </xs:complexType>
                </xs:element>
                <xs:element name="rankSystem">
                    <xs:complexType>
                        <xs:simpleContent>
                            <xs:extension base="xs:string">
                                <xs:attributeGroup
                                        ref="predicateAttributeGroup" />
                            </xs:extension>
                        </xs:simpleContent>
                    </xs:complexType>
                </xs:element>
                <xs:element name="rating">
                    <xs:complexType>
                        <xs:simpleContent>
                            <xs:extension base="xs:string">
                                <xs:attributeGroup
                                        ref="predicateAttributeGroup" />
                            </xs:extension>
                        </xs:simpleContent>
                    </xs:complexType>
                </xs:element>
            </xs:choice>
        </xs:complexType>
    </xs:element>

    <xs:element name="toc">
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" maxOccurs="1" name="unitType" type="tocType" />
                <xs:element minOccurs="0" maxOccurs="1" name="echelon" type="tocType" />
                <xs:element minOccurs="0" maxOccurs="1" name="rating" type="tocType" />
                <xs:element minOccurs="0" maxOccurs="1" name="flags" type="tocType" />
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- How this faction designates formations relative to their siblings, read by
         megamek FormationNamingConvention. The <name> elements on <force> supply the flavour part of a
         name ("Battle Lance", "Assault Cluster", "IV-alpha"); this supplies the positional part, which
         differs between the Inner Sphere, the Clans and ComStar. Authored in the four root rulesets
         (IS, CLAN, CS, Periphery) and inherited per echelon via the parent chain, so a faction can
         override one echelon without restating the rest. -->
    <xs:element name="formationNaming">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="tier" type="namingTierType" minOccurs="0"
                            maxOccurs="unbounded" />
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="namingTierType">
        <xs:attribute name="echelon" type="eschelonDefinition" use="required" />
        <xs:attribute name="designator" type="designatorStyleType" use="required" />
        <!-- "parent" prefixes the parent formation's designator, which is what keeps names unique
             once a designator sequence restarts under each parent. Omitted means unqualified. -->
        <xs:attribute name="qualifyWith">
            <xs:simpleType>
                <xs:restriction base="xs:string">
                    <xs:enumeration value="parent" />
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
    </xs:complexType>

    <!-- Matches megamek FormationNamingConvention.DesignatorStyle. "alphabet" is the only value that
         defers to the consumer's user-facing naming preference; the rest are fixed by the faction's
         own tradition. -->
    <xs:simpleType name="designatorStyleType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="engine" />
            <xs:enumeration value="alphabet" />
            <xs:enumeration value="ordinal" />
            <xs:enumeration value="numeric_ordinal" />
            <xs:enumeration value="roman" />
            <xs:enumeration value="greek" />
            <xs:enumeration value="number" />
        </xs:restriction>
    </xs:simpleType>

    <xs:element name="customRanks">
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" name="base" type="xs:string" />
                <xs:element maxOccurs="unbounded" name="rank">
                    <xs:simpleType>
                        <xs:restriction base="xs:string">
                            <xs:pattern value=".+:.+" />
                        </xs:restriction>
                    </xs:simpleType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- The loader (megamek Ruleset/ForceNode) reads force children by tag name with no ordering
         requirement, so the content model is an unordered repeated choice rather than a sequence.
         The shipped rulesets interleave weightTarget/co/rule elements freely, and a force is not
         required to declare a co. -->
    <xs:element name="force">
        <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element name="name">
                    <xs:complexType>
                        <xs:simpleContent>
                            <xs:extension base="xs:string">
                                <xs:attributeGroup
                                        ref="predicateAttributeGroup" />
                            </xs:extension>
                        </xs:simpleContent>
                    </xs:complexType>
                </xs:element>
                <xs:element name="weightTarget">
                    <xs:complexType>
                        <xs:simpleContent>
                            <xs:extension base="xs:string">
                                <xs:attribute name="unitType" type="xs:string" />
                                <xs:attribute name="spread" type="xs:decimal" />
                                <xs:attributeGroup
                                        ref="predicateAttributeGroup" />
                            </xs:extension>
                        </xs:simpleContent>
                    </xs:complexType>
                </xs:element>
                <xs:element name="co" type="commanderType" />
                <xs:element name="xo" type="commanderType" />
                <xs:group ref="ruleGroup" />
                <xs:element name="ruleGroup" type="ruleGroupType" />
                <xs:element name="subforces" type="subforcesType" />
                <xs:element name="attachedForces" type="subforcesType" />
            </xs:choice>

            <xs:attribute name="echelon" type="xs:string" use="required" />
            <xs:attribute name="eschName" type="xs:string" />
            <xs:attributeGroup ref="predicateAttributeGroup" />
        </xs:complexType>
    </xs:element>

    <xs:complexType name="tocType">
        <xs:sequence>
            <xs:element name="option" type="tocOptionType"
                        maxOccurs="unbounded" />
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="tocOptionType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attributeGroup ref="predicateAttributeGroup" />
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <xs:complexType name="commanderType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="position" type="xs:integer" />
                <xs:attribute name="title" type="xs:string" />
                <xs:attribute name="unitType" type="xs:string" />
                <xs:attributeGroup ref="predicateAttributeGroup" />
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <xs:complexType name="ruleGroupType">
        <xs:sequence>
            <xs:group ref="ruleGroup" minOccurs="0" maxOccurs="unbounded" />
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="optionGroupType">
        <xs:sequence>
            <xs:element name="option" type="optionType"
                        maxOccurs="unbounded" />
        </xs:sequence>

        <xs:attributeGroup ref="predicateAttributeGroup" />
    </xs:complexType>

    <xs:complexType name="optionType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <!-- Deprecated alias for ifDateBetween (predicateAttributeGroup); kept for backwards compatibility. -->
                <xs:attribute name="ifYearBetween" type="xs:string" />
                <xs:attribute name="weight" type="xs:integer"
                              default="1" />
                <xs:attribute name="num" type="xs:integer" />
                <xs:attributeGroup ref="predicateAttributeGroup" />
                <xs:attributeGroup ref="assertionAttributeGroup" />
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <xs:complexType name="subforcesType">
        <xs:choice>
            <xs:element name="asFaction" type="xs:string" />
            <xs:element name="asParent" type="xs:string" />
            <xs:choice maxOccurs="unbounded">
                <xs:element name="subforce" type="subforceType" />
                <xs:element name="subforceOption"
                            type="subforceOptionType" />
            </xs:choice>
        </xs:choice>

        <xs:attributeGroup ref="predicateAttributeGroup" />
        <xs:attribute name="generate" type="generateType" />
    </xs:complexType>

    <xs:complexType name="subforceType">
        <xs:simpleContent>
            <xs:extension base="eschelonDefinition">
                <xs:attributeGroup ref="predicateAttributeGroup" />
                <xs:attributeGroup ref="assertionAttributeGroup" />
                <xs:attribute name="num" type="xs:integer" default="1" />
                <xs:attribute name="generate" type="generateType" />
                <xs:attribute name="eschName" type="xs:string" />
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <!-- The generation-rule values the engine implements (ForceDescriptor); an empty value clears an
         inherited rule. -->
    <xs:simpleType name="generateType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="model" />
            <xs:enumeration value="chassis" />
            <xs:enumeration value="group" />
            <xs:enumeration value="" />
        </xs:restriction>
    </xs:simpleType>

    <!-- An echelon number or %CONSTANT%, optionally suffixed +, -, or ^.

         Derived from xs:token rather than xs:string with a whiteSpace facet: token collapses
         whitespace as a built-in property of the type, which validators apply before matching the
         pattern, whereas the facet on xs:string was not being applied to element content and left
         every indented <subforce>%CONSTANT%</subforce> failing the pattern. The reader trims the
         value in any case (ValueNode.loadFromXml), so this makes the schema agree with what the
         ruleset actually accepts. -->
    <xs:simpleType name="eschelonDefinition">
        <xs:restriction base="xs:token">
            <xs:pattern value="([0-9]+|%[A-Z_]+%)[+\-^]?" />
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="subforceOptionType">
        <xs:sequence>
            <xs:element name="option" type="optionType"
                        maxOccurs="unbounded" />
        </xs:sequence>

        <xs:attributeGroup ref="predicateAttributeGroup" />
        <xs:attribute name="generate" type="generateType" />
    </xs:complexType>

</xs:schema>
